#!/bin/sh
set -eu

export HOME="$SNAP_USER_DATA"
export XDG_CONFIG_HOME="$SNAP_USER_DATA/.config"
export XDG_DATA_HOME="$SNAP_USER_COMMON/.local/share"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
export JAVA_HOME="$SNAP/usr/lib/jvm/java-25-openjdk-amd64"
export JDK_JAVA_OPTIONS="${JDK_JAVA_OPTIONS:-} -Duser.home=$HOME"
export ELEVEN_JADX="$SNAP/opt/eleven/Resources/jadx/bin/jadx"
export ELEVEN_APKTOOL="$SNAP/bin/apktool"
export SHELL="$SNAP/bin/eleven-shell"
export PATH="$SNAP/bin:$SNAP/usr/bin:$JAVA_HOME/bin:$SNAP/opt/eleven/Resources/node/bin:$PATH"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME"
exec "$SNAP/opt/eleven/bin/eleven" "$@"
